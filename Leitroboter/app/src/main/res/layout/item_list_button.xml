<?xml version="1.0" encoding="utf-8"?>
<!-- Botón de una opción en la cuadrícula de screen_list.xml. Todos miden lo mismo: la fila
     reparte el alto y el texto usa un tamaño fijo por cuadrícula (MainActivity.fillGrid),
     con máximo dos líneas. -->
<Button xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Leitroboter.Button"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:layout_margin="4dp"
    android:minHeight="0dp"
    android:minWidth="0dp"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="0dp"
    android:paddingBottom="0dp"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="2"
    android:ellipsize="end" />
