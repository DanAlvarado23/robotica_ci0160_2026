<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingStart="32dp"
    android:paddingEnd="32dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/placeName"
        style="@style/Leitroboter.Title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="22sp"
        android:text="Nombre del lugar" />

    <!-- El mapa ocupa todo el espacio que dejan el nombre y la descripción -->
    <ImageView
        android:id="@+id/placeMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:scaleType="fitCenter"
        android:contentDescription="Mapa del lugar" />

    <!-- Descripción e indicaciones en una tarjeta compacta; el foco es el mapa porque Pepper ya las dice -->
    <TextView
        android:id="@+id/placeDescription"
        style="@style/Leitroboter.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/card_background"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="0dp"
        android:textSize="14sp" />

    <!-- Botón para volver al menú, debajo de la descripción para no tapar el mapa -->
    <Button
        android:id="@+id/backButton"
        style="@style/Leitroboter.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Regresar al menú"
        android:minHeight="52dp"
        android:textSize="18sp"
        android:layout_marginTop="6dp" />

</LinearLayout>
