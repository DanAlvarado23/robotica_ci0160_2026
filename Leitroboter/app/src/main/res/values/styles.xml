<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Botón azul grande, fácil de tocar en la tablet de Pepper -->
    <style name="Leitroboter.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/button_primary</item>
        <!-- Sin tinte, para que se vea el fondo azul de button_primary -->
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:minWidth">240dp</item>
        <item name="android:paddingStart">32dp</item>
        <item name="android:paddingEnd">32dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <!-- Títulos de cada pantalla -->
    <style name="Leitroboter.Title" parent="">
        <item name="android:textColor">@color/text_title</item>
        <item name="android:fontFamily">@font/poppins_semibold</item>
        <item name="fontFamily">@font/poppins_semibold</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Texto normal -->
    <style name="Leitroboter.Body" parent="">
        <item name="android:textColor">@color/text_body</item>
        <item name="android:lineSpacingExtra">4dp</item>
    </style>
</resources>
